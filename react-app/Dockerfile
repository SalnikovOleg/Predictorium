# Используем официальный образ Node.js
FROM node:24-alpine

# Устанавливаем рабочую директорию
WORKDIR /app

# Копируем файлы зависимостей
COPY package*.json ./

# Устанавливаем зависимости
RUN npm install

# Копируем остальной код
COPY . .

# Открываем порт 3000
EXPOSE 3000

# Команда для запуска сервера разработки
CMD ["npm", "run", "dev"]